<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>st3215_hardware_interface</name>
  <version>0.0.0</version>
  <description>ST3215 hardware interface for ros2_control</description>
  <maintainer email="anirudh110106@gmail.com">anirudh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/st3215_hardware_interface.xml"/>
  </export>
</package>